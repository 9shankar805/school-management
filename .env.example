APP_NAME=Unifiedtransform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=unifiedtransform
DB_USERNAME=unifiedtransform
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# ── Nepal SMTP options ────────────────────────────────────────────────────────
# Option 1: Gmail (most common for Nepal schools)
#   MAIL_HOST=smtp.gmail.com  |  PORT=587  |  ENCRYPTION=tls
#   MAIL_PASSWORD = App Password from myaccount.google.com/apppasswords
# Option 2: Hostinger / cPanel (mail.yourdomain.com, PORT=465, ENCRYPTION=ssl)
# Option 3: Mailtrap (for testing only — mailtrap.io)
# ─────────────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourschool.edu.np
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourschool.edu.np"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Module 22: Security ───────────────────────────────────────────────────────

# Anti-virus scanning for file uploads (requires ClamAV installed on server)
AV_SCAN_ENABLED=false
AV_SCAN_BINARY=/usr/bin/clamscan
AV_SCAN_TIMEOUT=30

# ── Module 23: Infrastructure — Laravel Horizon ───────────────────────────
HORIZON_PREFIX=school_erp_horizon:
HORIZON_PATH=horizon
HORIZON_EMAILS=

# ── Module 23: Infrastructure — Redis (activate to enable Horizon + fast queues)
# Switch QUEUE_CONNECTION=redis and CACHE_DRIVER=redis once Redis is running
# QUEUE_CONNECTION=redis
# CACHE_DRIVER=redis
# REDIS_CLIENT=predis

# ── Module 23: Infrastructure — S3 / Cloud Storage ───────────────────────
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_PUBLIC_BUCKET=
AWS_BACKUP_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SIGNED_URL_EXPIRY=900

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=school-erp
MINIO_ENDPOINT=http://localhost:9000

# ── Module 23: Infrastructure — Backup (spatie/laravel-backup) ────────────
BACKUP_NOTIFY_EMAIL=admin@school.local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_SLACK_CHANNEL=#backups
BACKUP_DISCORD_WEBHOOK_URL=

# ── WhatsApp / Messaging — Zavu ───────────────────────────────────────────────
# Get your API key at https://app.zavu.dev
# Docs: https://crubingllc.mintlify.app
ZAVU_API_KEY=
# Optional: pin a Sender ID from your Zavu dashboard (leave blank to use default)
ZAVU_SENDER_ID=
# Override base URL only if using a staging/proxy endpoint
ZAVU_BASE_URL=https://api.zavu.dev/v1

# ── Nepal Payment Gateways ────────────────────────────────────────────────────
# eSewa ePay v2 — https://developer.esewa.com.np
ESEWA_SECRET_KEY=
ESEWA_SUCCESS_URL="${APP_URL}/payment/esewa/success"
ESEWA_FAILURE_URL="${APP_URL}/payment/esewa/failure"

# Khalti Epayment v2 — https://khalti.com/api/docs/
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL="${APP_URL}/payment/khalti/callback"
KHALTI_WEBSITE_URL="${APP_URL}"

# Default online payment gateway (esewa | khalti | stripe)
PAYMENT_GATEWAY_DEFAULT=esewa

# ── Nepal SMS — Sparrow SMS ───────────────────────────────────────────────────
# Get token at: https://sparrowsms.com → Dashboard → API
SMS_PROVIDER=sparrow
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=NepalSchoolHub

# ── Firebase Cloud Messaging (FCM) ────────────────────────────────────────
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_PROJECT_ID=
FCM_VAPID_PUBLIC_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
