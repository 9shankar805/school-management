APP_NAME=Unifiedtransform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=unifiedtransform
DB_USERNAME=unifiedtransform
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Module 22: Security ───────────────────────────────────────────────────────

# Anti-virus scanning for file uploads (requires ClamAV installed on server)
AV_SCAN_ENABLED=false
AV_SCAN_BINARY=/usr/bin/clamscan
AV_SCAN_TIMEOUT=30

# ── Module 23: Infrastructure — Laravel Horizon ───────────────────────────
HORIZON_PREFIX=school_erp_horizon:
HORIZON_PATH=horizon
HORIZON_EMAILS=

# ── Module 23: Infrastructure — Redis (activate to enable Horizon + fast queues)
# Switch QUEUE_CONNECTION=redis and CACHE_DRIVER=redis once Redis is running
# QUEUE_CONNECTION=redis
# CACHE_DRIVER=redis
# REDIS_CLIENT=predis

# ── Module 23: Infrastructure — S3 / Cloud Storage ───────────────────────
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_PUBLIC_BUCKET=
AWS_BACKUP_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SIGNED_URL_EXPIRY=900

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=

MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=school-erp
MINIO_ENDPOINT=http://localhost:9000

# ── Module 23: Infrastructure — Backup (spatie/laravel-backup) ────────────
BACKUP_NOTIFY_EMAIL=admin@school.local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_SLACK_CHANNEL=#backups
BACKUP_DISCORD_WEBHOOK_URL=
